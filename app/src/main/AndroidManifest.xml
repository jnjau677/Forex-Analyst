<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      WHY POST_NOTIFICATIONS: from API 33 onward a notification posted without this
      runtime permission is silently dropped. Alert evaluation would appear to work
      (the alert is marked triggered, nothing is thrown) while the user never sees
      anything - the worst possible failure mode for an alert feature.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      WHY VIBRATE: the alert channel can be configured to vibrate. It is a normal
      (install-time) permission, so declaring it costs the user nothing, and omitting
      it makes vibration fail silently on the OEM builds that still check for it.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      WHY allowBackup stays true but is paired with explicit exclusions: backup is
      genuinely useful for a single-user app (settings, watchlist, drawings), while
      the two files that hold third-party API keys are excluded in res/xml so they
      never reach Google's servers or a device-to-device transfer.
    -->
    <application
        android:name=".ForexApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ForexAnalyst">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ForexAnalyst">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
